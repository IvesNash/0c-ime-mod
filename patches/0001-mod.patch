+package session
+
+import "testing"
+
+// 0c-ime-mod：單一個大寫字母後面接注音。
+func TestModUpperLetterThenZhuyin(t *testing.T) {
+	cases := []struct {
+		keys []string
+		want string
+	}{
+		{[]string{"P", "v", "u", ";", "3"}, "我P想"},             // 實際字典：P2k7 → P的
+		{[]string{"P", "z", "/", " "}, "我P風"},                  // 一聲接空白
+		{[]string{"P", "i", "g", "v", "u", ";", "3"}, "我Pig想"}, // Pig 是英文字，原本就切得開
+	}
+	for _, c := range cases {
+		s := mixedSession()
+		typeSyl(s, "ㄨㄛˇ")
+		var got string
+		for _, k := range c.keys {
+			got = key(s, k).Text()
+		}
+		if got != c.want {
+			t.Errorf("%v：%q，想要 %q", c.keys, got, c.want)
+		}
+	}
+}
+
+func TestModUpperLetterKeepsEnglish(t *testing.T) {
+	for _, word := range []string{"Pig", "Go", "Hi", "Ted", "Yes", "Ok"} {
+		s := mixedSession()
+		typeSyl(s, "ㄨㄛˇ")
+		for _, r := range word {
+			key(s, string(r))
+		}
+		if got := key(s, " ").Text(); got != "我"+word+" " && got != "我"+word {
+			t.Errorf("%s␣ 應照字面：%q", word, got)
+		}
+	}
+}
diff --git a/core/session/mod_toggle.go b/core/session/mod_toggle.go
new file mode 100644
index 0000000..229893c
--- /dev/null
+++ b/core/session/mod_toggle.go
@@ -0,0 +1,19 @@
+package session
+
+// 0c-ime-mod：切換中英時結束組字。
+//
+// 原本的做法（#90）只清掉沒打完的注音，組字區照樣開著；切到英文後打的字母會接進組字區，
+// 在 After Effects 這類沒有文字框的畫面上就是快捷鍵全被懸浮的組字視窗吃掉。
+// 開啟 EndOnToggle 時，單按 Shift 切換先清掉沒打完的注音、關掉候選，再把已組好的字送出，
+// 組字區關閉，之後的按鍵照模式直接交給程式。
+
+// modEndOnToggle 回傳要送出的文字；沒有組字時什麼都不做。
+func (s *Session) modEndOnToggle() string {
+	s.clearPendingZhuyin()
+	s.cand = nil
+	s.toggleStash = nil
+	if !s.composing() {
+		return ""
+	}
+	return s.commit()
+}
diff --git a/core/session/mod_toggle_test.go b/core/session/mod_toggle_test.go
