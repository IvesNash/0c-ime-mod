@@ -0,0 +1,84 @@
+package session
+
+import (
+	"testing"
+
+	"github.com/0c-biggo/0c-ime/core/proto"
+)
+
+// 0c-ime-mod：切換中英時結束組字。
+
+func TestModToggleEndsEnglishLiteralComposition(t *testing.T) {
+	// 在 AE 誤按 P、V、W（中英混打判成英文字），切英文後不能再讓快捷鍵進組字區。
+	s := mixedSession()
+	s.EndOnToggle = true
+	for _, k := range []string{"p", "v", "w"} {
+		key(s, k)
+	}
+	snap := s.Handle(proto.Request{Type: proto.Toggle})
+	if snap.Mode != proto.ModeEnglish || snap.Commit != "pvw" || s.composing() {
+		t.Fatalf("切換應送出組字並關閉組字區：%+v", snap)
+	}
+	if next := key(s, "v"); next.Handled {
+		t.Fatalf("切到英文後的按鍵應交給程式：%+v", next)
+	}
+}
+
+func TestModToggleDropsPendingKeepsComposed(t *testing.T) {
+	s := newSession()
+	s.EndOnToggle = true
+	pendingAfterWo(s) // 我 + ㄒㄧㄤ
+	snap := s.Handle(proto.Request{Type: proto.Toggle})
+	if snap.Commit != "我" || snap.Text() != "" || snap.Mode != proto.ModeEnglish {
+		t.Fatalf("送出已組好的字、丟掉沒打完的注音：%+v", snap)
+	}
+	// 立即切回不放回注音（已經送出）。
+	back := s.Handle(proto.Request{Type: proto.Toggle, Restore: true})
+	if back.Text() != "" || back.Mode != proto.ModeZhuyin || back.Commit != "" {
+		t.Fatalf("切回注音：%+v", back)
+	}
+}
+
+func TestModToggleOnlyPendingCommitsNothing(t *testing.T) {
+	s := mixedSession()
+	s.EndOnToggle = true
+	key(s, "p") // ㄣ
+	snap := s.Handle(proto.Request{Type: proto.Toggle})
+	if snap.Commit != "" || snap.Text() != "" || s.composing() {
+		t.Fatalf("只有沒打完的注音：清掉、不送出：%+v", snap)
+	}
+}
+
+func TestModToggleFromEnglishCommitsTypedText(t *testing.T) {
+	s := newSession()
+	s.EndOnToggle = true
+	typeSyl(s, "ㄨㄛˇ")
+	s.Handle(proto.Request{Type: proto.Toggle}) // 送出「我」
+	key(s, "a")                                 // 英文模式沒在組字：交給程式
+	if s.composing() {
+		t.Fatal("英文模式沒在組字時字母不進組字區")
+	}
+	if snap := s.Handle(proto.Request{Type: proto.Toggle}); snap.Mode != proto.ModeZhuyin || snap.Commit != "" {
+		t.Fatalf("切回注音：%+v", snap)
+	}
+}
+
+func TestModToggleOffKeepsOriginalBehavior(t *testing.T) {
+	s := mixedSession()
+	for _, k := range []string{"p", "v", "w"} {
+		key(s, k)
+	}
+	if snap := s.Handle(proto.Request{Type: proto.Toggle}); snap.Commit != "" || snap.Text() != "pvw" {
+		t.Fatalf("關閉時維持原本做法：%+v", snap)
+	}
+}
+
+func TestModModeRequestUnaffected(t *testing.T) {
+	// 外殼設定模式（換欄位、從英文開始的程式）不是使用者切換，不送出組字。
+	s := newSession()
+	s.EndOnToggle = true
+	pendingAfterWo(s)
+	if snap := s.Handle(proto.Request{Type: proto.Mode, On: true}); snap.Commit != "" {
+		t.Fatalf("mode 請求不送出：%+v", snap)
+	}
+}
