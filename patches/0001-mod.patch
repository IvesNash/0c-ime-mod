+++ b/platforms/settings/ui/mod.js
@@ -0,0 +1,83 @@
+// 0c-ime-mod：輸入設定頁的「中英切換（改裝）」卡片——切換時結束組字、一律從英文開始的程式。
+// app.js 只呼叫 ZcMod.keys 與 ZcMod.render；其他都在這裡，官方更新時比較不會衝突。
+(function () {
+  'use strict';
+  const KEYS = ['end-composition-on-toggle', 'english-apps'];
+  let picker = null; // { loading, apps: [{exe,title}], error }
+
+  function splitApps(value) {
+    return (value || '').split('|').map((s) => s.trim()).filter(Boolean);
+  }
+
+  function render(root, ctx) {
+    const { h, row, itemRow, changePairs, invoke, toast, state, locked, rerender } = ctx;
+    const items = (state.settings && state.settings.items) || [];
+    const endItem = items.find((item) => item.key === KEYS[0]);
+    const appsItem = items.find((item) => item.key === KEYS[1]);
+    if (!endItem && !appsItem) return;
+    const card = h('div', { class: 'card' });
+    if (endItem) card.append(itemRow(endItem, locked));
+    if (appsItem) card.append(appsBlock(appsItem));
+    root.append(h('h2', {}, '中英切換（改裝）'), card);
+
+    function save(list) {
+      return changePairs([[KEYS[1], list.length ? list.join('|') : 'none']]);
+    }
+
+    function appsBlock(item) {
+      const apps = splitApps(item.value);
+      const busy = locked || state.busy.has(item.key);
+      const listed = new Set(apps.map((a) => a.toLowerCase()));
+      const block = h('div', { class: 'mod-apps' },
+        h('div', {}, h('div', { class: 'label', id: 'label-' + item.key }, item.label),
+          h('div', { class: 'desc' }, item.description)),
+        h('ul', { class: 'mod-app-list', 'aria-labelledby': 'label-' + item.key },
+          apps.length
+            ? apps.map((exe) => h('li', {},
+              h('span', { class: 'mod-exe' }, exe),
+              h('button', {
+                type: 'button', class: 'secondary small', disabled: busy, 'aria-label': '從清單移除 ' + exe,
+                onclick: () => save(apps.filter((a) => a !== exe)),
+              }, '移除')))
+            : h('li', { class: 'mod-empty' }, '清單是空的')));
+      const field = h('input', {
+        type: 'text', class: 'mod-input', placeholder: '輸入執行檔名稱，例如 AfterFX.exe', 'aria-label': '新增程式', disabled: busy,
+        onkeydown: (event) => { if (event.key === 'Enter') add(); },
+      });
+      function add() {
+        let exe = field.value.trim().split(/[\\/]/).pop();
+        if (!exe) return;
+        if (!/\.exe$/i.test(exe)) exe += '.exe';
+        if (listed.has(exe.toLowerCase())) { toast('清單裡已經有 ' + exe, 'warn'); return; }
+        save(apps.concat([exe]));
+      }
+      block.append(h('div', { class: 'mod-add' }, field,
+        h('button', { type: 'button', class: 'secondary', disabled: busy, onclick: add }, '加入'),
+        h('button', {
+          type: 'button', class: 'primary', disabled: busy || (picker && picker.loading), onclick: async () => {
+            picker = { loading: true, apps: [] };
+            rerender();
+            try {
+              picker = { loading: false, apps: await invoke('list_window_apps') };
+            } catch (error) {
+              picker = { loading: false, apps: [], error: String(error) };
+            }
+            rerender();
+          },
+        }, picker && picker.loading ? '讀取中…' : '從開著的程式挑選…')));
+      if (picker && !picker.loading) {
+        const choices = picker.apps.filter((app) => !listed.has(String(app.exe).toLowerCase()));
+        block.append(h('div', { class: 'mod-picker', role: 'group', 'aria-label': '開著的程式' },
+          picker.error ? h('p', { class: 'desc' }, picker.error) : null,
+          !picker.error && !choices.length ? h('p', { class: 'desc' }, '沒有其他開著的程式') : null,
+          choices.map((app) => h('button', {
+            type: 'button', class: 'mod-pick', disabled: busy, onclick: () => { picker = null; save(apps.concat([app.exe])); },
+          }, h('span', { class: 'mod-exe' }, app.exe), app.title ? h('span', { class: 'desc' }, app.title) : null)),
+          h('button', { type: 'button', class: 'link', onclick: () => { picker = null; rerender(); } }, '關閉')));
+      }
+      return block;
+    }
+  }
+
+  window.ZcMod = { keys: KEYS, render };
+})();
