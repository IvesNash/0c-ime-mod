diff --git a/internal/settings/mod.go b/internal/settings/mod.go
new file mode 100644
index 0000000..7a85edc
--- /dev/null
+++ b/internal/settings/mod.go
@@ -0,0 +1,137 @@
+package settings
+
+// 0c-ime-mod：個人改裝的兩項設定，存在設定檔的保留成員（extra）裡，不改原本的結構與讀寫流程。
+// 官方版讀到這兩個鍵會當成不認得的欄位原樣保留，所以裝回官方版、再裝回改裝版時設定不會遺失。
+
+import (
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+)
+
+const (
+	modEndOnToggleKey  = "end_composition_on_toggle" // 設定檔欄位
+	modEnglishAppsKey  = "english_apps"
+	ModEndOnToggleItem = "end-composition-on-toggle" // 命令列／設定程式的鍵
+	ModEnglishAppsItem = "english-apps"
+	modMaxApps         = 64
+	modMaxAppLen       = 128
+)
+
+func (s Settings) modExtra() map[string]json.RawMessage {
+	kept := map[string]json.RawMessage{}
+	if s.extra != "" {
+		_ = json.Unmarshal([]byte(s.extra), &kept)
+	}
+	return kept
+}
+
+func (s *Settings) modSetExtra(key string, value any) error {
+	kept := s.modExtra()
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	kept[key] = raw
+	b, err := json.Marshal(kept)
+	if err != nil {
+		return err
+	}
+	s.extra = string(b)
+	return nil
+}
+
+// EndOnToggle：單按 Shift 切換中英時結束組字（送出已組好的字、清掉沒打完的注音）。預設開啟。
+func (s Settings) EndOnToggle() bool {
+	raw, ok := s.modExtra()[modEndOnToggleKey]
+	if !ok {
+		return true
+	}
+	var v bool
+	if json.Unmarshal(raw, &v) != nil {
+		return true
+	}
+	return v
+}
+
+// EnglishApps：一律從英文開始、不做英文自動補字的程式（執行檔名稱，不分大小寫）。
+func (s Settings) EnglishApps() []string {
+	raw, ok := s.modExtra()[modEnglishAppsKey]
+	if !ok {
+		return nil
+	}
+	var list []string
+	if json.Unmarshal(raw, &list) != nil {
+		return nil
+	}
+	return normalizeApps(list)
+}
+
+// normalizeApps 去掉空白、路徑與重複（不分大小寫），保留原本的大小寫與順序。
+func normalizeApps(list []string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, name := range list {
+		name = strings.TrimSpace(name)
+		if i := strings.LastIndexAny(name, `\/`); i >= 0 {
+			name = name[i+1:]
+		}
+		if name == "" || len(name) > modMaxAppLen || strings.ContainsAny(name, "|\"<>:*?\t\r\n") {
+			continue
+		}
+		key := strings.ToLower(name)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, name)
+		if len(out) == modMaxApps {
+			break
+		}
+	}
+	return out
+}
+
+func modSpecs() []spec {
+	return []spec{
+		{ModEndOnToggleItem, "切換中英時結束組字", "切換時關掉懸浮視窗，之後按鍵直接給程式", "on", []string{"on", "off"},
+			func(s Settings) string { return onOff(s.EndOnToggle()) }},
+		// 值是以 | 分隔的執行檔名稱；設定程式另外畫成清單。
+		{ModEnglishAppsItem, "一律從英文開始的程式", "這些程式一開就是英文，打中文再按右 Shift", "", []string{""},
+			func(s Settings) string { return strings.Join(s.EnglishApps(), "|") }},
+	}
+}
+
+// modSet 處理改裝的兩項；不是這兩項時回 handled=false，交回原本的 Set。
+func (s *Settings) modSet(key, value string) (bool, error) {
+	switch key {
+	case ModEndOnToggleItem:
+		if value != "on" && value != "off" {
+			return true, &SetError{Code: CodeInvalidValue, Key: key, Msg: key + " 只接受 on 或 off"}
+		}
+		return true, s.modSetExtra(modEndOnToggleKey, value == "on")
+	case ModEnglishAppsItem:
+		var list []string
+		if strings.TrimSpace(value) != "" && value != "none" {
+			list = strings.Split(value, "|")
+		}
+		apps := normalizeApps(list)
+		if len(list) > 0 && len(apps) == 0 {
+			return true, &SetError{Code: CodeInvalidValue, Key: key, Msg: fmt.Sprintf("%s 的程式名稱不正確：%q", key, value)}
+		}
+		if apps == nil {
+			apps = []string{}
+		}
+		return true, s.modSetExtra(modEnglishAppsKey, apps)
+	}
+	return false, nil
+}
+
+// ModAppListed 回報執行檔名稱是否在清單中（不分大小寫）。
+func ModAppListed(apps []string, exe string) bool {
+	return slices.ContainsFunc(apps, func(a string) bool { return strings.EqualFold(a, exe) })
+}
+
+// EnglishAppsJoined 是給外殼的清單（以 | 分隔）。
+func (s Settings) EnglishAppsJoined() string { return strings.Join(s.EnglishApps(), "|") }
