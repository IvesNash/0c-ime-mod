@@ -0,0 +1,57 @@
+//! 0c-ime-mod：「一律從英文開始的程式」清單的挑選器——列出目前有視窗的程式（執行檔名稱與視窗標題）。
+use serde_json::{json, Value};
+
+/// 目前有主視窗的程式；同一個執行檔只列一次。非 Windows 回空清單。
+#[tauri::command]
+pub async fn list_window_apps() -> Result<Value, String> {
+    tauri::async_runtime::spawn_blocking(scan)
+        .await
+        .map_err(|e| e.to_string())?
+}
+
+#[cfg(windows)]
+fn scan() -> Result<Value, String> {
+    use std::os::windows::process::CommandExt;
+    // 以 PowerShell 列出有主視窗的行程；不加相依套件。CREATE_NO_WINDOW 不閃黑窗。
+    let script = "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Process | Where-Object { $_.MainWindowHandle -ne 0 -and $_.Path } | \
+        ForEach-Object { [IO.Path]::GetFileName($_.Path) + \"`t\" + $_.MainWindowTitle }";
+    let out = std::process::Command::new("powershell.exe")
+        .args(["-NoProfile", "-NonInteractive", "-Command", script])
+        .creation_flags(0x0800_0000)
+        .output()
+        .map_err(|e| format!("無法列出程式：{e}"))?;
+    let text = String::from_utf8_lossy(&out.stdout);
+    Ok(Value::Array(parse(&text)))
+}
+
+#[cfg(not(windows))]
+fn scan() -> Result<Value, String> {
+    Ok(Value::Array(Vec::new()))
+}
+
+/// 每行「執行檔名稱<Tab>視窗標題」；略過空行與重複的執行檔（不分大小寫），依名稱排序。
+fn parse(text: &str) -> Vec<Value> {
+    let mut seen = std::collections::HashSet::new();
+    let mut apps: Vec<(String, String)> = Vec::new();
+    for line in text.lines() {
+        let (exe, title) = line.split_once('\t').unwrap_or((line, ""));
+        let exe = exe.trim();
+        if exe.is_empty() || !seen.insert(exe.to_ascii_lowercase()) {
+            continue;
+        }
+        apps.push((exe.to_string(), title.trim().to_string()));
+    }
+    apps.sort_by_key(|(exe, _)| exe.to_ascii_lowercase());
+    apps.into_iter().map(|(exe, title)| json!({"exe": exe, "title": title})).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn parse_dedupes_and_sorts() {
+        let got = super::parse("notepad.exe\t無標題\nAfterFX.exe\tAdobe After Effects\nafterfx.exe\tx\n\n");
+        assert_eq!(got.len(), 2);
+        assert_eq!(got[0]["exe"], "AfterFX.exe");
+        assert_eq!(got[1]["title"], "無標題");
+    }
+}
