+//! 0c-ime-mod：「一律從英文開始的程式」。引擎在 health／open 的 info 回報 english_apps（執行檔名稱以 | 分隔），
+//! 這個程式在清單裡時：還不知道中英模式（剛開的程式）就從英文開始，英文模式也不做自動補字（字母直接交給程式）。
+use serde_json::Value;
+
+/// `exe` 是否在 info 的 english_apps 清單裡（不分大小寫）。
+pub fn listed_in(info: &Value, exe: &str) -> bool {
+    info["english_apps"]
+        .as_str()
+        .is_some_and(|list| list.split('|').any(|app| !app.is_empty() && app.eq_ignore_ascii_case(exe)))
+}
+
+/// 目前的程式是否在清單裡。
+pub fn listed(info: &Value) -> bool {
+    listed_in(info, crate::log::exe_name())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn matches_exe_case_insensitively() {
+        let info = json!({"english_apps": "AfterFX.exe|Adobe Premiere Pro.exe"});
+        assert!(listed_in(&info, "afterfx.EXE"));
+        assert!(listed_in(&info, "Adobe Premiere Pro.exe"));
+        assert!(!listed_in(&info, "Photoshop.exe"));
+        assert!(!listed_in(&json!({"english_apps": ""}), ""));
+        assert!(!listed_in(&json!({}), "AfterFX.exe"));
+    }
+}
