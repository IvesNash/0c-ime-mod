@@ -0,0 +1,40 @@
+package session
+
+// 0c-ime-mod：中英混打時，單一個大寫字母後面接注音。
+//
+// 原本的英→中切點（mixedBoundary，#119）要求英文前段是字典認得的字、數字或標點，或至少兩個字母，
+// 所以「輸入P的話」打成 P2k7cj84 會整串留成英文。大寫字母只能按著 Shift 打出來，不會是注音鍵，
+// 後面的按鍵照注音順序（聲母、介音、韻母）組成常用字時，就在大寫字母後面切開：P2k7 → P的、Psu3 → P你。
+// 接空白的一聲（P5␣ → P之）也切，但整串是英文字（Pig、Ted）時照字面。
+
+import (
+	"strings"
+
+	"github.com/0c-biggo/0c-ime/core/zhuyin"
+)
+
+// modUpperSplit 回傳大寫字母之後（切點 1）的音節；不符合時 ok=false。
+func (s *Session) modUpperSplit(raw, key string, tone rune) (zhuyin.Syllable, bool) {
+	// 後段至少兩鍵：一鍵的音節（Ok3、Go␣）跟英文分不開。
+	if len(raw) < 3 || raw[0] < 'A' || raw[0] > 'Z' {
+		return "", false
+	}
+	rest := raw[1:]
+	if strings.ContainsFunc(rest, func(r rune) bool { return r >= 'A' && r <= 'Z' || r > 0x7f }) {
+		return "", false
+	}
+	if !s.keysInSyllableOrder(rest) {
+		return "", false
+	}
+	if key == " " && s.mixedEnglishWord(raw) {
+		return "", false // Pig␣、Ted␣ 是英文字
+	}
+	done, ok := s.mixedReading(rest, tone)
+	if !ok || tone == '˙' && done.ToneOf() != 5 {
+		return "", false
+	}
+	if s.mixedSyllableScore(done) < mixedUnknownWordFloor {
+		return "", false
+	}
+	return done, true
+}
