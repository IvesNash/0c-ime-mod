+package settings
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestModDefaultsAndRoundTrip(t *testing.T) {
+	s := Default()
+	if !s.EndOnToggle() || len(s.EnglishApps()) != 0 {
+		t.Fatalf("預設：切換結束組字開、清單空：%v %v", s.EndOnToggle(), s.EnglishApps())
+	}
+	if err := s.Set(ModEndOnToggleItem, "off"); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Set(ModEnglishAppsItem, `AfterFX.exe|C:\Program Files\Adobe\Adobe Premiere Pro.exe|afterfx.EXE| `); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "settings.json")
+	if err := Save(path, s); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := r.Settings
+	if got.EndOnToggle() {
+		t.Fatal("關閉後存檔再讀應為 off")
+	}
+	for _, note := range r.Notes {
+		if strings.Contains(note, "english_apps") || strings.Contains(note, "end_composition_on_toggle") {
+			t.Fatalf("改裝的欄位不該出現在「不認得的欄位」提示：%q", note)
+		}
+	}
+	if apps := got.EnglishApps(); len(apps) != 2 || apps[0] != "AfterFX.exe" || apps[1] != "Adobe Premiere Pro.exe" {
+		t.Fatalf("清單去掉路徑與重複：%q", apps)
+	}
+	if v, _ := got.Value(ModEnglishAppsItem); v != "AfterFX.exe|Adobe Premiere Pro.exe" {
+		t.Fatalf("Value：%q", v)
+	}
+	if !ModAppListed(got.EnglishApps(), "afterfx.exe") || ModAppListed(got.EnglishApps(), "Photoshop.exe") {
+		t.Fatal("比對不分大小寫")
+	}
+	// 其他設定照常改，改裝的兩項不受影響。
+	if err := got.Set("esc-clear", "off"); err != nil || got.EndOnToggle() || len(got.EnglishApps()) != 2 {
+		t.Fatalf("改其他設定後：%v %v %v", err, got.EndOnToggle(), got.EnglishApps())
+	}
+	if err := got.Set(ModEnglishAppsItem, "none"); err != nil || len(got.EnglishApps()) != 0 {
+		t.Fatalf("清空：%v %v", err, got.EnglishApps())
+	}
+	if err := got.Set(ModEndOnToggleItem, "maybe"); err == nil {
+		t.Fatal("不合法的值應回錯誤")
+	}
+}
